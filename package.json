{
  "name": "vertexlabs-web",
  "version": "0.1.0",
  "description": "Landing de VertexLabs: paquetes de páginas web y tiendas en línea para PyME mexicana",
  "author": "Víctor Manuel Santos Martínez",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ng": "ng",
    "tokens": "node scripts/tokens.mjs",
    "start": "pnpm tokens && ng serve",
    "build": "pnpm tokens && ng build",
    "preview": "node scripts/serve-dist.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "ng test --watch=false",
    "e2e": "pnpm build && playwright test",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\"",
    "verify": "node scripts/tokens.mjs --check && pnpm typecheck && pnpm test && pnpm e2e"
  },
  "dependencies": {
    "@angular/cdk": "~21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.26",
    "@ng-icons/core": "~33.4.0",
    "@ng-icons/lucide": "~33.4.0",
    "@spartan-ng/brain": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "~1.63.0",
    "@spartan-ng/cli": "1.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
