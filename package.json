{
  "name": "vertexlabs-web",
  "version": "0.1.0",
  "description": "Sitio de Vertex Labs: estudio digital en Pachuca que hace sitios web, tiendas en línea y sistemas para PyMEs",
  "author": "Víctor Manuel Santos Martínez",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "ng test --watch=false",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "check:design": "node scripts/check-design.mjs"
  },
  "dependencies": {
    "@angular/cdk": "~21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.26",
    "@spartan-ng/brain": "1.6.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "@spartan-ng/cli": "1.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
